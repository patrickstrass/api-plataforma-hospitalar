# Preserve o MONGO_URI do seu .env. Nunca versione credenciais reais.
MONGO_URI=mongodb://127.0.0.1:27017/hospital?replicaSet=rs0
PORT=3000
JWT_SECRET=
JWT_EXPIRES_IN=30m
FRONTEND_ORIGIN=http://localhost:4200
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_EMAIL=
# Chave PEM da conta de serviço, com quebras representadas por \n.
GOOGLE_PRIVATE_KEY=
GOOGLE_API_TIMEOUT_MS=5000
GOOGLE_API_MAX_ATTEMPTS=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_MS=30000
# Preencher somente para executar npm run seed.
SEED_ADMIN_EMAIL=admin@hospital.test
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador
